+#if defined(A5XELTE)
+/*
+ * star2lte (0126): one-shot list of every kernel thread with its wait state and a
+ * short backtrace of where it blocked, printed with kprintf. Called from the idle
+ * path (single CPU, interrupts masked), so the thread list cannot change under us.
+ * Columns: tid, state (1=wait, 4=run, 80=idle), wait event, continuation (low 32 bits),
+ * then the saved LR and up to 4 caller return addresses (low 32 bits; kernel text is
+ * 0xfffffff0xxxxxxxx).
+ */
+void
+a5xelte_thread_dump(void)
+{
+	thread_t t;
+	unsigned total = 0;
+
+	kprintf("S9DIAG threads: tid state event cont | lr callers\n");
+	queue_iterate(&threads, t, thread_t, threads) {
+		uint64_t lr = 0, caller[4] = { 0, 0, 0, 0 };
+		total++;
+		if (t->kernel_stack != 0 && t->machine.kstackptr != 0) {
+			thread_kernel_state_t ks = (thread_kernel_state_t)t->machine.kstackptr;
+			uint64_t fp = ks->machine.ss.fp;
+			uint64_t lo = (uint64_t)t->kernel_stack;
+			uint64_t hi = lo + (uint64_t)kernel_stack_size;
+			lr = ks->machine.ss.lr;
+			for (unsigned i = 0; i < 4; i++) {
+				if (fp < lo || fp + 16 > hi || (fp & 7) != 0) {
+					break;
+				}
+				caller[i] = ((uint64_t *)fp)[1];
+				fp = ((uint64_t *)fp)[0];
+			}
+		}
+		kprintf("T%llu s%x e%llx c%08x | %08x %08x %08x %08x %08x\n",
+		    (unsigned long long)thread_tid(t), (unsigned)t->state,
+		    (unsigned long long)t->wait_event,
+		    (unsigned)(uintptr_t)t->continuation,
+		    (unsigned)lr, (unsigned)caller[0], (unsigned)caller[1],
+		    (unsigned)caller[2], (unsigned)caller[3]);
+	}
+	kprintf("S9DIAG threads total=%u\n", total);
+}
+#endif /* A5XELTE */
