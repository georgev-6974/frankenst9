+static void
+s9survey_pdump(const char *tag, vm_offset_t base, unsigned len)
+{
+	for (unsigned o = 0; o < len; o += 16) {
+		char b[4][12];
+		for (unsigned i = 0; i < 4; i++) {
+			uint32_t x = 0;
+			if (s9_probe_read32(base + o + 4 * i, &x)) {
+				snprintf(b[i], sizeof(b[i]), "--------");
+			} else {
+				snprintf(b[i], sizeof(b[i]), "%08x", x);
+			}
+		}
+		printf("S9SURVEY %s +%03x: %s %s %s %s\n", tag, o, b[0], b[1], b[2], b[3]);
+	}
+}
