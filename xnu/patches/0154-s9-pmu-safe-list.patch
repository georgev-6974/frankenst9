+/* s9pmu_ok: PMU byte offsets known to be readable (0152 aborted reading the whole block) */
+static bool
+s9pmu_ok(uint32_t o)
+{
+	return o == 0x414 || o == 0x41C || o == 0x500 || o == 0x1088 ||
+	       (o >= 0x2000 && o <= 0x203C) || o == 0x2040 || o == 0x2044 || o == 0x204C ||
+	       o == 0x2114 || o == 0x2180 || o == 0x21EC || o == 0x2258 ||
+	       o == 0x2380 || o == 0x2384;
+}
