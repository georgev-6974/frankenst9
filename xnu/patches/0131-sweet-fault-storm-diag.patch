+		static unsigned int s9_aff_n, s9_aff_printed;
+		s9_aff_n++;
+		if (s9_aff_n >= 2048 && (s9_aff_n & 1023) == 0 && s9_aff_printed < 40) {
+			s9_aff_printed++;
+			printf("S9FF n %u va 0x%llx ft 0x%x spte 0x%llx now 0x%llx kpmap %d\n", s9_aff_n,
+			    (unsigned long long)va, (unsigned)fault_type, (unsigned long long)spte,
+			    (unsigned long long)*((volatile pt_entry_t *)ptep), (int)(pmap == kernel_pmap));
+		}
+	}
+
 	pvh_unlock(pai);
 	pmap_unlock(pmap, PMAP_LOCK_SHARED);
 	return result;
