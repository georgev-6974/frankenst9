+/*
+ * Samsung Galaxy S9+ (SM-G965F, star2lte, Exynos 9810) build, layered on
+ * the DREAMLTE settings above (same 0xcc000000 1440x2960 framebuffer,
+ * GIC-400, 26 MHz physical timer PPI 14). Measured S9+ facts:
+ * docs/star2lte-facts, STAR2LTE_PROGRESS.md. Nothing here ran on a phone.
+ */
+#define STAR2LTE                      1
+#if defined(STAR2LTE)
+/* No ramoops on this TWRP: the entry marker lives in loader RAM just above
+ * the 63-block LDRLOG buffer (shim/star2lte/loader.c LDR_LOG_PHYS +
+ * 63 * 4096), in the high bank outside the XNU window. */
+#undef A5_ENTRY_MARKER_PHYS
+#define A5_ENTRY_MARKER_PHYS          0x8f013f000
+/* The boot CPU is whatever the ADT calls logical CPU 0 (the loader banner
+ * prints the real MPIDR_EL1; rerun make-boot.sh --boot-mpidr if it differs). */
+#undef A5_BOOT_MPIDR
+#define A5_BOOT_MPIDR                 (ml_get_topology_info()->boot_cpu->phys_id)
+#undef A5_KEYS_DEFAULT
+#define A5_KEYS_DEFAULT               0           /* S8 GPIO bases do not apply */
+#endif
