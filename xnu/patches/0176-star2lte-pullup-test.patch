diff --git a/bsd/dev/a5xelte_touch.c b/bsd/dev/a5xelte_touch.c
index 4c1891b..3d2a4d6 100644
--- a/bsd/dev/a5xelte_touch.c
+++ b/bsd/dev/a5xelte_touch.c
@@ -1354,6 +1354,45 @@ s9survey_thread(void *arg, wait_result_t result)
 		}
 	}
 
+	if (level == 14) {
+		vm_offset_t i2c = ml_io_map(S9_I2C_PA, 0x1000);
+		vm_offset_t usi = ml_io_map(0x10411000, 0x1000);
+		uint8_t b[3] = { 0, 0, 0 };
+		uint32_t u0 = 0xdead;
+		if (!i2c || !usi) {
+			printf("S9SURVEY P14: mapping failed\n");
+		} else if (s9_probe_read32(usi + 0x1c, &u0)) {
+			printf("S9SURVEY P14: usi +1c read faulted\n");
+		} else {
+			uint32_t con = a5touch_read(pin, 0x20);
+			uint32_t pud = a5touch_read(pin, 0x28);
+			static const uint32_t pulls[3] = { 0, 1, 3 };
+			a5touch_write(usi, 0x1c, 4);
+			a5touch_write(pin, 0x20, con & ~0x00ff0000u);
+			for (int k = 0; k < 3; k++) {
+				a5touch_write(pin, 0x28, (pud & ~0x00000f00u) | ((pulls[k] * 5u) << 8));
+				for (volatile int d = 0; d < 2000000; d++) { }
+				printf("S9SURVEY P14 input pull=%u DAT %08x\n", pulls[k], a5touch_read(pin, 0x24));
+			}
+			a5touch_write(pin, 0x20, (con & ~0x00ff0000u) | 0x00220000u);
+			a5touch_write(pin, 0x28, (pud & ~0x00000f00u) | 0x00000f00u);
+			for (volatile int d = 0; d < 2000000; d++) { }
+			printf("S9SURVEY P14 i2c mux, pull-up: DAT %08x\n", a5touch_read(pin, 0x24));
+			s9i2c_reset(i2c);
+			if (s9i2c_cmd_read(i2c, 0x55, b, 1)) {
+				printf("S9SURVEY P14: chip ACKed at 0x48, cmd 0x55 -> %02x\n", b[0]);
+			} else {
+				printf("S9SURVEY P14: no ACK from 0x48\n");
+			}
+			printf("S9SURVEY P14 INT_STATUS %08x FIFO_STAT %08x DAT %08x\n",
+			    a5touch_read(i2c, 0x24), a5touch_read(i2c, 0x30), a5touch_read(pin, 0x24));
+			a5touch_write(pin, 0x20, con);
+			a5touch_write(pin, 0x28, pud);
+			a5touch_write(usi, 0x1c, u0);
+			printf("S9SURVEY P14: restored\n");
+		}
+	}
+
 	for (unsigned i = 0; i < 64; i++) {
 		prev[i] = a5touch_read(aon, i * 4);
 	}
