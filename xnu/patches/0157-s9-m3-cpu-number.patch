diff --git a/osfmk/arm64/machine_routines.c b/osfmk/arm64/machine_routines.c
index 2f57ff6..8aeeeac 100644
--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -1219,6 +1219,19 @@ ml_get_boot_cluster_type(void)
 	return topology_info.boot_cluster->cluster_type;
 }
 
+/* sweet_norm_mpidr: raw MPIDR_EL1 -> ADT phys id. An Exynos M3 (MIDR implementer 0x53) reads
+ * 0x100+core, which collides with A55 core 1; the ADT gives it 0x400 + (core << 8). */
+static uint32_t
+sweet_norm_mpidr(uint64_t mpidr)
+{
+	uint64_t midr = 0;
+	MRS(midr, "MIDR_EL1");
+	if (((midr >> 24) & 0xff) == 0x53) {
+		return 0x400U + (uint32_t)((mpidr & 0xff) << 8);
+	}
+	return (uint32_t)mpidr;
+}
+
 int
 ml_get_cpu_number(uint32_t phys_id)
 {
@@ -1254,7 +1267,7 @@ ml_get_cpu_number_local(void)
 
 	/* We identify the CPU based on the constant bits of MPIDR_EL1. */
 	MRS(mpidr_el1_value, "MPIDR_EL1");
-	cpu_id = ml_get_cpu_number((uint32_t)mpidr_el1_value);
+	cpu_id = ml_get_cpu_number(sweet_norm_mpidr(mpidr_el1_value));
 
 	assert(cpu_id <= (unsigned int)ml_get_max_cpu_number());
 
@@ -1269,7 +1282,7 @@ ml_get_cluster_number_local()
 
 	/* We identify the cluster based on the constant bits of MPIDR_EL1. */
 	MRS(mpidr_el1_value, "MPIDR_EL1");
-	cluster_id = ml_get_cluster_number((uint32_t)mpidr_el1_value);
+	cluster_id = ml_get_cluster_number(sweet_norm_mpidr(mpidr_el1_value));
 
 	assert(cluster_id <= (unsigned int)ml_get_max_cluster_number());
 
